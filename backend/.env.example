# Serveur
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wikisguessr

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Brevo (emails transactionnels)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=WikisGuessr

# DeepL
DEEPL_API_KEY=your_deepl_api_key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_DAILY_REQUEST_LIMIT=500
# Optionnel: definir une limite journaliere de tokens pour afficher un restant tokens.
GEMINI_DAILY_TOKEN_LIMIT=

# Stripe Checkout (abonnements recurrents)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optionnel : IDs Price créés dans Stripe. Sans eux, Checkout crée les tarifs depuis les montants de l'application.
STRIPE_SILVER_PRICE_ID=
STRIPE_GOLD_PRICE_ID=
